# Bu dosyayı kopyalayıp `.env` adıyla kaydedin ve gerçek değerleri girin.
# `.env` .gitignore'da — asla commit'lenmez.

# Supabase (Project Settings > API sayfasından alınır)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (console.twilio.com'dan alınır)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Whisper model boyutu (opsiyonel, varsayılan "base")
WHISPER_MODEL_SIZE=base

# Sadece bulut deploy'unda (ör. Railway) gerekli. Yerelde gerekmez — orada
# claude-agent-sdk zaten sisteme giriş yapılmış `claude` CLI'ını kullanır.
# console.anthropic.com'dan alınır, kullanım bazlı ücretlendirilir (Claude.ai
# aboneliğinden ayrı bir şeydir).
ANTHROPIC_API_KEY=
